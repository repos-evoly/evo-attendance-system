generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  employeeId   Int             @id @map("employee_id")
  fullName     String          @map("full_name") @db.VarChar(150)
  department   String?         @db.VarChar(100)
  jobTitle     String?         @map("job_title") @db.VarChar(100)
  phone        String?         @db.VarChar(30)
  hireDate     DateTime?       @map("hire_date") @db.Date
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  shiftId      Int?            @map("shift_id")
  attendance   Attendance[]
  shift        Shift?          @relation(fields: [shiftId], references: [shiftId], onDelete: NoAction, onUpdate: NoAction)
  leaves       EmployeeLeave[]
  waivers      Waiver[]
  shiftHistory EmployeeShift[]

  @@index([shiftId])
  @@map("employee")
}

model Shift {
  shiftId          Int             @id @default(autoincrement()) @map("shift_id")
  name             String          @unique @db.VarChar(100)
  timeIn           DateTime        @map("time_in") @db.Time(6)
  timeOut          DateTime        @map("time_out") @db.Time(6)
  allowanceMinutes Int             @default(15) @map("allowance_minutes")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  attendance       Attendance[]
  employees        Employee[]
  assignments      EmployeeShift[]

  @@map("shifts")
}

model EmployeeShift {
  id         BigInt    @id @default(autoincrement())
  employeeId Int       @map("employee_id")
  shiftId    Int       @map("shift_id")
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  employee   Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: NoAction, onUpdate: NoAction)
  shift      Shift     @relation(fields: [shiftId], references: [shiftId], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId, startDate])
  @@index([shiftId])
  @@map("employee_shifts")
}

model Attendance {
  attendanceId   BigInt    @id @default(autoincrement()) @map("attendance_id")
  employeeId     Int       @map("employee_id")
  attendanceDate DateTime  @map("attendance_date") @db.Date
  shiftId        Int       @map("shift_id")
  scheduledIn    DateTime  @map("scheduled_in") @db.Time(6)
  scheduledOut   DateTime  @map("scheduled_out") @db.Time(6)
  checkIn        DateTime? @map("check_in") @db.Timestamp(6)
  checkOut       DateTime? @map("check_out") @db.Timestamp(6)
  waiver         Boolean   @default(false) @map("waiver")
  status         String?   @map("status") @db.VarChar(20)
  requiredMinutes Int?     @map("required_minutes")
  actualMinutes   Int?     @map("actual_minutes")
  missingMinutes  Int?     @map("missing_minutes")
  lateMinutes     Int      @default(0) @map("late_minutes")
  workedMinutes   Int?     @map("worked_minutes")
  effectiveStart  String?   @map("effective_start") @db.VarChar(5)
  punchCount      Int      @default(0) @map("punch_count")
  employee       Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: NoAction, onUpdate: NoAction)
  shift          Shift     @relation(fields: [shiftId], references: [shiftId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, attendanceDate])
  @@index([shiftId])
  @@map("attendance")
}

model DevicePunch {
  id             BigInt   @id @default(autoincrement())
  deviceUserId   String   @map("device_user_id") @db.VarChar(64)
  punchedAtLocal DateTime @map("punched_at_local") @db.Timestamp(6)
  punchType      Int      @map("punch_type") @db.SmallInt
  verifyStatus   Int      @map("verify_status") @db.SmallInt
  deviceSerial   String?  @map("device_serial") @db.VarChar(64)
  source         String   @default("device") @db.VarChar(32)
  importedAt     DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([deviceUserId, punchedAtLocal, punchType, verifyStatus], map: "device_punches_unique_event")
  @@index([punchedAtLocal], map: "device_punches_punched_at_idx")
  @@index([deviceUserId], map: "device_punches_user_idx")
  @@map("device_punches")
}

model User {
  userId            BigInt          @id @default(autoincrement()) @map("user_id")
  username          String          @unique @db.VarChar(100)
  passwordHash      String          @map("password_hash")
  role              String          @default("ADMIN") @db.VarChar(30)
  isActive          Boolean         @default(true) @map("is_active")
  lastLoginAt       DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledLeaves   EmployeeLeave[] @relation("LeaveCancelledBy")
  createdLeaves     EmployeeLeave[] @relation("LeaveCreatedBy")
  revokedWaivers    Waiver[]        @relation("WaiverRevokedBy")
  waivedWaivers     Waiver[]        @relation("WaiverGrantedBy")
  createdHolidays   PublicHoliday[] @relation("HolidayCreatedBy")
  cancelledHolidays PublicHoliday[] @relation("HolidayCancelledBy")

  @@map("users")
}

/// Audit trail for waivers: who granted the waiver and why, plus who revoked it
/// afterwards. Revoking never deletes the row, so grant and revocation history
/// both survive; the value the calculators read stays `attendance.waiver`.
model Waiver {
  waiverId         BigInt    @id @default(autoincrement()) @map("waiver_id")
  employeeId       Int       @map("employee_id")
  waiverDate       DateTime  @map("waiver_date") @db.Date
  reason           String
  waivedById       BigInt    @map("waived_by_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById      BigInt?   @map("revoked_by_id")
  revocationReason String?   @map("revocation_reason")
  employee         Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: NoAction, onUpdate: NoAction, map: "waivers_employee_fk")
  revokedBy        User?     @relation("WaiverRevokedBy", fields: [revokedById], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "waivers_revoked_by_fk")
  waivedBy         User      @relation("WaiverGrantedBy", fields: [waivedById], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "waivers_waived_by_fk")

  @@index([revokedById], map: "waivers_revoked_by_idx")
  @@index([waivedById], map: "waivers_waived_by_idx")
  @@map("waivers")
}

/// Approved leave periods. `dateTo` is inclusive.
///
/// Records are never deleted: cancelling flips `status` to CANCELLED and fills
/// the cancellation columns, so the original request stays visible. Only ACTIVE
/// rows are read by the attendance calculators.
model EmployeeLeave {
  leaveId            BigInt      @id @default(autoincrement()) @map("leave_id")
  employeeId         Int         @map("employee_id")
  dateFrom           DateTime    @map("date_from") @db.Date
  dateTo             DateTime    @map("date_to") @db.Date
  leaveType          LeaveType   @map("leave_type")
  reason             String?
  createdById        BigInt      @map("created_by_id")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  status             LeaveStatus @default(ACTIVE)
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      BigInt?     @map("cancelled_by_id")
  cancellationReason String?     @map("cancellation_reason")
  cancelledBy        User?       @relation("LeaveCancelledBy", fields: [cancelledById], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "employee_leave_cancelled_by_fk")
  createdBy          User        @relation("LeaveCreatedBy", fields: [createdById], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "employee_leave_created_by_fk")
  employee           Employee    @relation(fields: [employeeId], references: [employeeId], onDelete: NoAction, onUpdate: NoAction, map: "employee_leave_employee_fk")

  @@index([status])
  @@index([cancelledById], map: "employee_leave_cancelled_by_idx")
  @@index([createdById], map: "employee_leave_created_by_idx")
  @@index([employeeId, dateFrom], map: "employee_leave_employee_from_idx")
  @@map("employee_leave")
}

model SyncRun {
  id                BigInt    @id @default(autoincrement())
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)
  status            String    @db.VarChar(32)
  deviceIp          String?   @map("device_ip") @db.VarChar(64)
  deviceSerial      String?   @map("device_serial") @db.VarChar(64)
  usersSeen         Int       @default(0) @map("users_seen")
  recordsSeen       Int       @default(0) @map("records_seen")
  recordsNew        Int       @default(0) @map("records_new")
  duplicatesSkipped Int       @default(0) @map("duplicates_skipped")
  error             String?

  @@index([startedAt(sort: Desc)])
  @@map("sync_runs")
}

/// Public holiday periods. `dateTo` is inclusive.
///
/// One public holiday record applies automatically to all eligible active employees.
/// No per-employee mapping is created. Only active records are read by the attendance
/// calculators. Records are never deleted; cancelling fills the cancellation columns,
/// so the original request stays visible. Only active records (cancelledAt IS NULL)
/// are read by the attendance calculators.
model PublicHoliday {
  holidayId          BigInt    @id @default(autoincrement()) @map("holiday_id")
  name               String    @db.VarChar(200)
  dateFrom           DateTime  @map("date_from") @db.Date
  dateTo             DateTime  @map("date_to") @db.Date
  reason             String?   @db.Text
  createdById        BigInt    @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      BigInt?   @map("cancelled_by_id")
  cancellationReason String?   @map("cancellation_reason")

  createdBy   User  @relation("HolidayCreatedBy", fields: [createdById], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  cancelledBy User? @relation("HolidayCancelledBy", fields: [cancelledById], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([dateFrom])
  @@index([createdById])
  @@index([cancelledById], map: "public_holidays_cancelled_by_idx")
  @@map("public_holidays")
}

model schema_migrations {
  migration_name String   @id @db.VarChar(255)
  checksum       String   @db.VarChar(64)
  applied_at     DateTime @default(now()) @db.Timestamptz(6)
}

enum LeaveStatus {
  ACTIVE
  CANCELLED
}

enum LeaveType {
  VACATION
  UNPAID
  SICK_LEAVE
}
