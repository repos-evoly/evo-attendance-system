# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
out/

# production
/build

# device sync service: a separate process with its own node_modules and artifacts
sync/node_modules
sync/data
sync/out

# local artifacts and data exports
data/
dumps/
*.db
*.csv
*.xlsx

# misc
.DS_Store
*.pem

# Windows reserved device name (can be created accidentally by shell redirection)
nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit real values, but keep the example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local database backups
/backups/
