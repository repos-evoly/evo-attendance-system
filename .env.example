# Environment variable NAMES only, with placeholder values.
# Copy this file to .env and replace the placeholders locally.
# No real values and no secrets belong in this file.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/attendance
DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@HOST:PORT/attendance
PG_SYNC_URL=postgresql://USER:PASSWORD@HOST:PORT/attendance
DEVICE_IP=0.0.0.0
DEVICE_PORT=4370
