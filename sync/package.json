
{
  "name": "attendance-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only attendance sync service for the ZKTeco device (isolated from the Next.js app)",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "sync": "npx tsx src/sync.ts",
    "sync:postgres": "npx tsx src/sync-postgres.ts",
    "sync:auto": "npx tsx src/sync-scheduler.ts",
    "sync:status": "npx tsx src/sync-status.ts",
    "report": "npx tsx src/report-cli.ts",
    "employee:set-active": "npx tsx src/employee-set-active.ts",
    "test": "npx tsx --test src/sync-postgres.test.ts src/zk-tcp-reassembly.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@graphland/zkteco": "0.1.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
